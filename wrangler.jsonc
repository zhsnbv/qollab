{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qollab",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/video/chat-themes/*"
    ]
  },
  "main": "worker/video-assets.js"
}
